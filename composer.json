{
    "name": "verificrca/sdk",
    "description": "SDK oficial PHP pentru API-ul verificrca.ro: verificare RCA, ITP, rovinieta si copie conforma ARR dupa numar de inmatriculare sau serie de sasiu (VIN), plus gestionarea flotei si webhook-uri.",
    "type": "library",
    "license": "MIT",
    "keywords": ["verificrca", "verificare rca", "verificare itp", "verificare rovinieta", "copie conforma arr", "rca", "itp", "rovinieta", "certificat de inmatriculare", "asigurare auto", "romania", "flota", "webhook", "sdk", "api client", "psr-18"],
    "homepage": "https://www.verificrca.ro/api-acces",
    "support": {
        "issues": "https://github.com/verificrca/sdk_php/issues",
        "source": "https://github.com/verificrca/sdk_php",
        "email": "contact@verificrca.ro"
    },
    "authors": [
        {"name": "verificrca", "email": "contact@verificrca.ro", "homepage": "https://www.verificrca.ro"}
    ],
    "require": {
        "php": "^8.1",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.8",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5",
        "symfony/http-client": "^6.4"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Client HTTP folosit automat, cu timeoutMs aplicat",
        "symfony/http-client": "Alternativa la Guzzle, tot cu timeoutMs aplicat"
    },
    "autoload": {
        "psr-4": {"VerificRca\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"VerificRca\\Tests\\": "tests/", "VerificRca\\E2e\\": "e2e/"}
    },
    "scripts": {
        "test": "phpunit",
        "test:e2e": "phpunit -c phpunit.e2e.xml.dist",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "verifica": ["@cs", "@stan", "@test"]
    },
    "config": {
        "sort-packages": true,
        "platform": {"php": "8.1.0"},
        "allow-plugins": {"php-http/discovery": false}
    },
    "minimum-stability": "stable"
}
