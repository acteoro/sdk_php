{
    "name": "acteo/api",
    "description": "SDK oficial PHP pentru API-ul public Acteo: verificare RCA, ITP, rovinieta si copie conforma ARR dupa numar de inmatriculare sau serie de sasiu (VIN), plus decodare VIN, numere de inmatriculare disponibile, poze de masini, gestionarea flotei si webhook-uri.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "acteo",
        "verificrca",
        "verificare rca",
        "verificare itp",
        "verificare rovinieta",
        "copie conforma arr",
        "rca",
        "itp",
        "rovinieta",
        "certificat de inmatriculare",
        "asigurare auto",
        "romania",
        "flota",
        "webhook",
        "decodare vin",
        "vin decoder",
        "numere disponibile",
        "numar inmatriculare disponibil",
        "dgpci",
        "imagini masini",
        "poze masini",
        "sdk",
        "api client",
        "psr-18",
        "vehicle insurance check",
        "vehicle inspection",
        "road tax",
        "vin"
    ],
    "homepage": "https://acteo.ro/api-acces",
    "support": {
        "issues": "https://github.com/acteoro/sdk_php/issues",
        "source": "https://github.com/acteoro/sdk_php",
        "email": "contact@acteo.ro"
    },
    "authors": [
        {
            "name": "Acteo.ro",
            "email": "contact@acteo.ro",
            "homepage": "https://acteo.ro"
        }
    ],
    "require": {
        "php": "^8.1",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.8",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5",
        "symfony/http-client": "^6.4"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Client HTTP folosit automat, cu timeoutMs aplicat",
        "symfony/http-client": "Alternativa la Guzzle, tot cu timeoutMs aplicat"
    },
    "autoload": {
        "psr-4": {
            "Acteo\\": "src/"
        },
        "files": [
            "src/aliasuri-verificrca.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Acteo\\Tests\\": "tests/",
            "Acteo\\E2e\\": "e2e/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:e2e": "phpunit -c phpunit.e2e.xml.dist",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "verifica": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable"
}
